[Unit]
Description=Management Portal Shell
After=network-online.target
Wants=network-online.target

[Service]
# Portal's request path runs ahead of agent commands and tests under CPU contention.
CPUWeight=1000
Type=simple
WorkingDirectory=@PORTAL_SOURCE_ROOT@
ExecStart=@PORTAL_GROUP_COMMAND@@PORTAL_INSTANCES_ROOT@/dev/runtime-venv/bin/python -m uvicorn management_portal.asgi:app --host 127.0.0.1 --port 18086 --workers 1 --no-access-log --timeout-graceful-shutdown 15
ExecStop=/usr/bin/python3 @PORTAL_SOURCE_ROOT@/scripts/restart_portal_with_notice.py --no-restart --sleep
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
