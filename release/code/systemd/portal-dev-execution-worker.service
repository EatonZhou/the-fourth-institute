[Unit]
Description=TFI Portal Dev ExecutionWorker
After=network-online.target @PORTAL_POSTGRES_UNIT@ portal-dev-nats.service portal-dev-execution-service.service portal-claude-code.service portal-kimi-code.service
Wants=network-online.target @PORTAL_POSTGRES_UNIT@ portal-dev-nats.service portal-dev-execution-service.service portal-claude-code.service portal-kimi-code.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Type=simple
UMask=0007
WorkingDirectory=@PORTAL_SOURCE_ROOT@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PORTAL_INSTANCE=dev
Environment=PORTAL_ISA_ROUTING=socket
EnvironmentFile=@PORTAL_INSTANCES_ROOT@/dev/source-generation.env
EnvironmentFile=-@PORTAL_POSTGRES_ENV_FILE@
Environment=PORTAL_NATS_URL=nats://127.0.0.1:4223
Environment=PORTAL_EXECUTION_WORKER_ID=dev:execution-worker
Environment=PORTAL_EXECUTION_SERVICE_SOCKET=@PORTAL_INSTANCES_ROOT@/dev/execution-service.sock
Environment=PORTAL_EXECUTION_STATE_ROOT=@PORTAL_STAGING_ROOT@/portal_execution
Environment=PORTAL_EXECUTION_WORKER_HEALTH_PATH=@PORTAL_INSTANCES_ROOT@/dev/execution-worker-health.json
Environment=PORTAL_EXECUTION_WORKER_SOURCE_ROOT=@PORTAL_SOURCE_ROOT@
Environment=PORTAL_EXECUTION_WORKER_GENERATION_ENV=@PORTAL_INSTANCES_ROOT@/dev/source-generation.env
EnvironmentFile=-@PORTAL_RENDERED_CONFIG_ROOT@/portal-kimi-code.env
ExecStart=@PORTAL_INSTANCES_ROOT@/dev/runtime-venv/bin/python -m management_portal.execution.worker_manager
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
LogRateLimitIntervalSec=1min
LogRateLimitBurst=100
TimeoutStopSec=90

[Install]
WantedBy=portal-dev-execution.target
