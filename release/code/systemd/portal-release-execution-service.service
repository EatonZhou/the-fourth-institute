[Unit]
Description=TFI Portal Release ExecutionService
After=network-online.target @PORTAL_POSTGRES_UNIT@ portal-release-nats.service
Requires=@PORTAL_POSTGRES_UNIT@ portal-release-nats.service
Wants=network-online.target

[Service]
# Portal's request path runs ahead of agent commands and tests under CPU contention.
CPUWeight=1000
Environment=PYTHONDONTWRITEBYTECODE=1
Type=simple
UMask=0007
WorkingDirectory=@PORTAL_SOURCE_ROOT@
Environment=PORTAL_INSTANCE=release
Environment=PORTAL_ISA_ROUTING=socket
EnvironmentFile=-@PORTAL_POSTGRES_ENV_FILE@
Environment=PORTAL_NATS_URL=nats://127.0.0.1:4224
Environment=PORTAL_EXECUTION_SERVICE_SOCKET=@PORTAL_INSTANCES_ROOT@/release/execution-service.sock
Environment=PORTAL_EXECUTION_MAX_CONCURRENCY=8
Environment=PORTAL_EXECUTION_DISPATCH_INTERVAL_MIN_SECONDS=2
Environment=PORTAL_EXECUTION_DISPATCH_INTERVAL_MAX_SECONDS=6
ExecStart=@PORTAL_INSTANCES_ROOT@/dev/runtime-venv/bin/python @PORTAL_SOURCE_ROOT@/scripts/run_portal_shared_component.py execution-service
Restart=always
RestartSec=2
ExecReload=/bin/kill -HUP $MAINPID
NotifyAccess=all
KillMode=process
TimeoutStopSec=infinity

[Install]
WantedBy=portal-release-execution.target
