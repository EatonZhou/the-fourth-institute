[Unit]
Description=TFI Portal Dev ExecutionService
After=network-online.target @PORTAL_POSTGRES_UNIT@ portal-dev-nats.service
Requires=@PORTAL_POSTGRES_UNIT@ portal-dev-nats.service
Wants=network-online.target

[Service]
# Portal's request path runs ahead of agent commands and tests under CPU contention.
CPUWeight=1000
Type=simple
UMask=0007
WorkingDirectory=@PORTAL_SOURCE_ROOT@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PORTAL_INSTANCE=dev
Environment=PORTAL_ISA_ROUTING=socket
EnvironmentFile=@PORTAL_INSTANCES_ROOT@/dev/source-generation.env
EnvironmentFile=-@PORTAL_POSTGRES_ENV_FILE@
Environment=PORTAL_NATS_URL=nats://127.0.0.1:4223
Environment=PORTAL_EXECUTION_SERVICE_SOCKET=@PORTAL_INSTANCES_ROOT@/dev/execution-service.sock
Environment=PORTAL_EXECUTION_MAX_CONCURRENCY=8
Environment=PORTAL_EXECUTION_DISPATCH_INTERVAL_MIN_SECONDS=2
Environment=PORTAL_EXECUTION_DISPATCH_INTERVAL_MAX_SECONDS=6
ExecStart=@PORTAL_INSTANCES_ROOT@/dev/runtime-venv/bin/python -m management_portal.execution.service
Restart=always
RestartSec=2
ExecReload=/bin/kill -HUP $MAINPID
NotifyAccess=all
# Replaced generations exit themselves after their accepted responses finish.
KillMode=process
TimeoutStopSec=infinity

[Install]
WantedBy=portal-dev-execution.target
