#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
INSTANCE_ROOT="$(python3 "$ROOT/management_common/instance_paths.py" --instance dev)"
VENV="$INSTANCE_ROOT/runtime-venv"
USER_UNITS="$HOME/.config/systemd/user"
PORTAL_DROPINS="$USER_UNITS/management-portal.service.d"

mkdir -p "$INSTANCE_ROOT" "$USER_UNITS" "$PORTAL_DROPINS"
if [[ ! -x "$VENV/bin/python" ]]; then
  python3 -m venv --system-site-packages "$VENV"
fi
"$VENV/bin/python" -m pip install --disable-pip-version-check \
  -r "$ROOT/requirements-portal-runtime.txt"
case "${PORTAL_INSTALL_RESIDENT_EMBEDDINGS:-0}" in
  1)
    # The pinned local inference path does not use upstream download dependencies.
    "$VENV/bin/python" -m pip install --disable-pip-version-check \
      -r "$ROOT/requirements-society-service.txt"
    "$VENV/bin/python" "$ROOT/scripts/install_portal_embedding_model.py"
    ;;
  0)
    ;;
  *)
    printf '%s\n' 'PORTAL_INSTALL_RESIDENT_EMBEDDINGS must be 0 or 1' >&2
    exit 2
    ;;
esac

"$VENV/bin/python" "$ROOT/scripts/prepare_agent_runtimes.py"

"$VENV/bin/python" - "$ROOT" <<'INSTALL'
import sys
sys.path.insert(0, sys.argv[1])
from scripts.portal_service_units import install_units
install_units()
INSTALL
POSTGRES_UNIT="$("$VENV/bin/python" - "$ROOT" <<'PYTHON'
import sys
sys.path.insert(0, sys.argv[1])
from management_common.postgres_configuration import postgres_settings
print(postgres_settings()['unit'])
PYTHON
)"
systemctl --user enable "$POSTGRES_UNIT"
"$VENV/bin/python" "$ROOT/scripts/portal_dev_generation.py"
systemctl --user enable --now portal-dev-source-reloader.service

if [[ ! -x /usr/sbin/nats-server ]]; then
  printf '%s\n' \
    'Core NATS is not installed. Run: sudo apt-get install -y nats-server'
fi
printf 'Prepared Portal dev runtime at %s\n' "$VENV"
