#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
POSTGRES_SETTINGS="$(python3 - "$ROOT" <<'PYTHON'
import sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
from management_common.postgres_configuration import postgres_settings
from management_common.site_config import read_site_config
settings = postgres_settings()
configured = read_site_config().get('deployment', {}).get('postgres', {})
if (Path(settings['data']) / 'PG_VERSION').exists() and not {'role', 'database'} <= configured.keys():
    raise SystemExit('An existing PostgreSQL cluster requires its exact role and database in deployment.postgres')
for key in ('prefix', 'bin', 'lib', 'share', 'base', 'socket', 'data', 'unit', 'role', 'database', 'port'):
    print(settings[key])
PYTHON
)"
mapfile -t PG_SETTINGS <<< "$POSTGRES_SETTINGS"
PREFIX="${PG_SETTINGS[0]}"
PGBIN="${PG_SETTINGS[1]}"
PGLIB="${PG_SETTINGS[2]}"
PGSHARE="${PG_SETTINGS[3]}"
PGBASE="${PG_SETTINGS[4]}"
PGSOCKET="${PG_SETTINGS[5]}"
PGDATA="${PG_SETTINGS[6]}"
PGUNIT="${PG_SETTINGS[7]}"
PGROLE="${PG_SETTINGS[8]}"
PGDATABASE="${PG_SETTINGS[9]}"
PGPORT="${PG_SETTINGS[10]}"

if [[ ! -x "$PGBIN/postgres" ]]; then
  package_dir="$(mktemp -d /tmp/tfi-postgresql-packages.XXXXXX)"
  trap 'rm -rf -- "$package_dir"' EXIT
  (
    cd "$package_dir"
    apt-get download postgresql-16 postgresql-client-16 libpq5
    for package in ./*.deb; do
      dpkg-deb -x "$package" "$PREFIX"
    done
  )
fi

mkdir -p "$PGDATA" "$PGSOCKET" "$PGBASE/log" "$HOME/.config/systemd/user"
chmod 700 "$PGDATA" "$PGSOCKET" "$PGBASE/log"
if [[ ! -f "$PGDATA/PG_VERSION" ]]; then
  LD_LIBRARY_PATH="$PGLIB" "$PGBIN/initdb" \
    -D "$PGDATA" -L "$PGSHARE" \
    --username="$PGROLE" --encoding=UTF8 --locale=C.UTF-8 \
    --auth-local=trust --auth-host=scram-sha-256
fi

python3 "$ROOT/scripts/portal_instance_storage.py" install-unit \
  "$ROOT/systemd/portal-postgresql.service" \
  "$HOME/.config/systemd/user/$PGUNIT"
systemctl --user daemon-reload
systemctl --user enable --now "$PGUNIT"

if ! LD_LIBRARY_PATH="$PGLIB" "$PGBIN/psql" \
    -h "$PGSOCKET" -p "$PGPORT" -U "$PGROLE" -d postgres -Atqc \
    "SELECT 1 FROM pg_database WHERE datname='$PGDATABASE'" | grep -qx 1; then
  LD_LIBRARY_PATH="$PGLIB" "$PGBIN/createdb" \
    -h "$PGSOCKET" -p "$PGPORT" -U "$PGROLE" "$PGDATABASE"
fi

python3 - "$PGROLE" "$PGDATABASE" "$PGSOCKET" "$PGPORT" <<'PYTHON'
import sys
from urllib.parse import quote, urlencode
role, database, socket, port = sys.argv[1:]
print('PostgreSQL is ready.')
print('PORTAL_DATABASE_URL=postgresql://' + quote(role) + '@/' + quote(database) + '?' + urlencode({'host': socket, 'port': port}))
PYTHON
