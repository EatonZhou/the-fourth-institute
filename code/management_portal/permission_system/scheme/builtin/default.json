{
  "schema": "tfi.permission-scheme.v2",
  "scheme_id": "default",
  "title": "默认方案",
  "description": "Portal 的分级权限规则（decision_600ae27b0538）：树按 Portal 对象的自然归属分层，User 按分类（Portal 管理员、一般用户、实习用户）放在 P 树对应节点下，Portal 管理员与全员可读写在“共享”节点上，一般用户管理全部 Project，个人空间天然私有，个人 AMA 放在所有者的个人空间下，其中的 Resident 由引擎按所有者判定；受保护指令按参数要求 A 树节点：查看 @viewer、协作 @contributor、管理 @admin，或给 Resident 发消息 @message。",
  "trees": {
    "P": {
      "root": "@principals",
      "default_parent": "@users",
      "nodes": [
        {
          "id": "@principals",
          "title": "全部主体"
        },
        {
          "id": "@users",
          "parent": "@principals",
          "title": "User"
        },
        {
          "id": "@portal_admins",
          "parent": "@users",
          "title": "Portal 管理员",
          "user_category": "portal_admin"
        },
        {
          "id": "@members",
          "parent": "@users",
          "title": "一般用户",
          "user_category": "member"
        },
        {
          "id": "@interns",
          "parent": "@users",
          "title": "实习用户",
          "user_category": "intern"
        },
        {
          "id": "@residents",
          "parent": "@principals",
          "title": "Resident"
        },
        {
          "id": "@project_residents",
          "parent": "@residents",
          "title": "每个 Project",
          "each": "project"
        },
        {
          "id": "@lineage_residents",
          "parent": "@project_residents",
          "title": "每个 Lineage",
          "each": "lineage",
          "under": "project",
          "otherwise": "@residents"
        },
        {
          "id": "@resident",
          "parent": "@lineage_residents",
          "title": "每个 Resident",
          "each": "resident",
          "under": "lineage",
          "otherwise": "@residents"
        }
      ]
    },
    "A": {
      "root": "@actions",
      "default_parent": "@admin",
      "nodes": [
        {
          "id": "@actions",
          "title": "全部动作"
        },
        {
          "id": "@free",
          "parent": "@actions",
          "title": "免检"
        },
        {
          "id": "@admin",
          "parent": "@actions",
          "title": "管理（admin）"
        },
        {
          "id": "@contributor",
          "parent": "@admin",
          "title": "协作（contributor）"
        },
        {
          "id": "@viewer",
          "parent": "@contributor",
          "title": "查看（viewer）"
        },
        {
          "id": "@message",
          "parent": "@contributor",
          "title": "给 Resident 发消息"
        }
      ]
    },
    "R": {
      "root": "@portal",
      "default_parent": "@shared",
      "nodes": [
        {
          "id": "@portal",
          "title": "Portal"
        },
        {
          "id": "@shared",
          "parent": "@portal",
          "title": "共享"
        },
        {
          "id": "@accounts",
          "parent": "@shared",
          "title": "每个 User 账号",
          "each": "user"
        },
        {
          "id": "@chatroom",
          "parent": "@shared",
          "title": "每个聊天室",
          "each": "chatroom"
        },
        {
          "id": "@notice",
          "parent": "@shared",
          "title": "每个帖子",
          "each": "notice"
        },
        {
          "id": "@operations",
          "parent": "@shared",
          "title": "Portal 运维"
        },
        {
          "id": "@projects",
          "parent": "@shared",
          "title": "全部 Project"
        },
        {
          "id": "@public",
          "parent": "@shared",
          "title": "公共内容"
        },
        {
          "id": "@papers",
          "parent": "@public",
          "title": "论文库"
        },
        {
          "id": "@project",
          "parent": "@projects",
          "title": "每个 Project",
          "each": "project"
        },
        {
          "id": "@project_paper",
          "parent": "@project",
          "title": "Project 内的论文",
          "each": "paper",
          "under": "project",
          "otherwise": "@papers"
        },
        {
          "id": "@project_content",
          "parent": "@project",
          "title": "Project 内的知识、skill、todo 与 repo",
          "under": "project",
          "otherwise": "@public",
          "each": [
            "article",
            "concept",
            "decision",
            "experiment",
            "idea",
            "information",
            "insight",
            "material",
            "meeting",
            "patent",
            "plan",
            "question",
            "repo",
            "review",
            "risk",
            "skill",
            "thinking",
            "todo"
          ]
        },
        {
          "id": "@lineage",
          "parent": "@project",
          "title": "每个 Lineage",
          "each": "lineage",
          "under": "project",
          "otherwise": "@shared"
        },
        {
          "id": "@resident",
          "parent": "@lineage",
          "title": "每个 Resident",
          "each": "resident",
          "under": "lineage"
        },
        {
          "id": "@workspace",
          "parent": "@resident",
          "title": "Resident 自有的 Workspace",
          "each": "workspace",
          "under": "resident"
        },
        {
          "id": "@project_workbench",
          "parent": "@project",
          "title": "Project 内的 Workbench",
          "each": "workbench",
          "under": "project",
          "otherwise": "@public"
        },
        {
          "id": "@workbench",
          "parent": "@lineage",
          "title": "每个 Workbench",
          "each": "workbench",
          "under": "lineage",
          "otherwise": "@public"
        },
        {
          "id": "@family",
          "parent": "@lineage",
          "title": "每个 Family",
          "each": "family",
          "under": "lineage"
        },
        {
          "id": "@personal",
          "parent": "@portal",
          "title": "个人"
        },
        {
          "id": "@personal_space",
          "parent": "@personal",
          "title": "每个 User 的个人空间",
          "each": "personal_space"
        },
        {
          "id": "@personal_ama_space",
          "parent": "@personal_space",
          "title": "个人 AMA",
          "each": "lineage",
          "under": "personal_space",
          "otherwise": "@personal"
        }
      ]
    }
  },
  "entries": [
    {
      "id": "exempt",
      "effect": "permit",
      "p": "@principals",
      "a": "@free",
      "r": "@portal",
      "title": "免检放行"
    },
    {
      "id": "everyone_reads",
      "effect": "permit",
      "p": "@principals",
      "a": "@viewer",
      "r": "@shared",
      "title": "全员可读"
    },
    {
      "id": "everyone_manages_public",
      "effect": "permit",
      "p": "@principals",
      "a": "@admin",
      "r": "@public",
      "title": "全员可管理公共内容"
    },
    {
      "id": "administrators",
      "effect": "permit",
      "p": "@portal_admins",
      "a": "@actions",
      "r": "@shared",
      "title": "Portal 管理员"
    },
    {
      "id": "members_manage_projects",
      "effect": "permit",
      "p": "@members",
      "a": "@admin",
      "r": "@projects",
      "title": "一般用户管理全部 Project"
    },
    {
      "id": "project_creator",
      "effect": "permit",
      "relation": "creator",
      "a": "@admin",
      "r": "@project",
      "title": "Project 创建人"
    },
    {
      "id": "chatroom_creator",
      "effect": "permit",
      "relation": "creator",
      "a": "@admin",
      "r": "@chatroom",
      "title": "聊天室创建者"
    },
    {
      "id": "post_author",
      "effect": "permit",
      "relation": "creator",
      "a": "@admin",
      "r": "@notice",
      "title": "帖子作者"
    },
    {
      "id": "account_self",
      "effect": "permit",
      "relation": "self",
      "a": "@admin",
      "r": "@accounts",
      "title": "账号本人"
    },
    {
      "id": "personal_space",
      "effect": "permit",
      "relation": "owner",
      "a": "@admin",
      "r": "@personal_space",
      "title": "个人空间"
    },
    {
      "id": "project_members",
      "effect": "permit",
      "relation": "belongs",
      "a": "@admin",
      "r": "@project",
      "title": "Project 内管理"
    },
    {
      "id": "steward",
      "effect": "permit",
      "relation": "steward",
      "a": "@admin",
      "r": "@lineage",
      "title": "Family steward"
    },
    {
      "id": "chatroom_members",
      "effect": "permit",
      "relation": "members",
      "a": "@contributor",
      "r": "@chatroom",
      "title": "聊天室成员"
    },
    {
      "id": "everyone_messages",
      "effect": "permit",
      "p": "@principals",
      "a": "@message",
      "r": "@portal",
      "title": "全员可给 Resident 发消息（含个人 AMA）"
    }
  ],
