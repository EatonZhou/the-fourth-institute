[Unit]
Description=Portal Codex app-server (account %i)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONPATH=@PORTAL_CODE_ROOT@
@PORTAL_PROVIDER_EGRESS_DIRECTIVE@
ExecStart=@PORTAL_PYTHON@ -m management_portal.codex_app_server_host --socket @PORTAL_INSTANCES_ROOT@/sockets/codex-%i.sock --binary @PORTAL_CODEX_BINARY@ --account-config @PORTAL_ACCOUNT_RUNTIME_ROOT@/codex/%i/launch.json
Restart=always
RestartSec=2
TimeoutStopSec=45
MemoryHigh=32G
MemoryMax=36G
MemorySwapMax=1G

[Install]
WantedBy=default.target
