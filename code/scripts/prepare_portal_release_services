#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
INSTANCE_ROOT="$(python3 "$ROOT/management_common/instance_paths.py")"
python3 "$ROOT/scripts/prepare_agent_runtimes.py"
python3 - "$ROOT" "$INSTANCE_ROOT" <<'PY'
import sys
from pathlib import Path
sys.path.insert(0, sys.argv[1])
from scripts.portal_release import link
from scripts.portal_service_units import install_units
instances = Path(sys.argv[2])
runtime = instances / 'dev/runtime-venv'
if not (runtime / 'bin/python').is_file():
    raise RuntimeError('Shared Python runtime is unavailable; run prepare_portal_dev_services')
link(runtime.resolve(), instances / 'release/runtime-venv')
install_units()
PY
