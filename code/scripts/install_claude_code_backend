#!/usr/bin/env bash
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
exec "${PORTAL_PYTHON:-python3}" - "$ROOT" "$@" <<'PYTHON'
import argparse
import sys
sys.path.insert(0, sys.argv[1])
from scripts.portal_service_units import install_claude_backend
parser = argparse.ArgumentParser(description="Install the local Claude daemon, reusing an existing SDK.")
parser.add_argument("--app-server-only", action="store_true")
args = parser.parse_args(sys.argv[2:])
unit = install_claude_backend(app_server_only=args.app_server_only)
print(f"Claude Code backend installed: {unit}")
PYTHON
