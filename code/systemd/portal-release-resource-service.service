[Unit]
Description=TFI Portal Release ResourceService
After=network-online.target @PORTAL_POSTGRES_UNIT@ portal-release-nats.service
Requires=@PORTAL_POSTGRES_UNIT@ portal-release-nats.service
Wants=network-online.target

[Service]
# Portal's request path runs ahead of agent commands and tests under CPU contention.
CPUWeight=1000
Environment=PYTHONDONTWRITEBYTECODE=1
Type=simple
UMask=0007
WorkingDirectory=@PORTAL_SOURCE_ROOT@
Environment=PORTAL_INSTANCE=release
Environment=PORTAL_ISA_ROUTING=socket
EnvironmentFile=-@PORTAL_POSTGRES_ENV_FILE@
Environment=PORTAL_NATS_URL=nats://127.0.0.1:4224
Environment=PORTAL_RESOURCE_SERVICE_MODE=local
Environment=PORTAL_RESOURCE_SERVICE_PROCESS=1
Environment=PORTAL_RESOURCE_SERVICE_SOCKET=@PORTAL_INSTANCES_ROOT@/release/resource-service.sock
Environment=PORTAL_RESOURCE_SERVICE_DB=@PORTAL_INSTANCES_ROOT@/release/resource-service.partition
Environment=PORTAL_RESOURCE_DATABASE_SCHEMA=resource_release
ExecStart=@PORTAL_GROUP_COMMAND@@PORTAL_INSTANCES_ROOT@/dev/runtime-venv/bin/python @PORTAL_SOURCE_ROOT@/scripts/run_portal_shared_component.py resource-service
Restart=always
RestartSec=2
TimeoutStopSec=90

[Install]
WantedBy=portal-release-execution.target
