[Unit]
Description=TFI Portal Dev ResourceService
After=network-online.target @PORTAL_POSTGRES_UNIT@ portal-dev-nats.service
Requires=@PORTAL_POSTGRES_UNIT@ portal-dev-nats.service
Wants=network-online.target

[Service]
# Portal's request path runs ahead of agent commands and tests under CPU contention.
CPUWeight=1000
Type=simple
UMask=0007
WorkingDirectory=@PORTAL_SOURCE_ROOT@
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PORTAL_INSTANCE=dev
Environment=PORTAL_ISA_ROUTING=socket
EnvironmentFile=@PORTAL_INSTANCES_ROOT@/dev/source-generation.env
EnvironmentFile=-@PORTAL_POSTGRES_ENV_FILE@
Environment=PORTAL_NATS_URL=nats://127.0.0.1:4223
Environment=PORTAL_RESOURCE_SERVICE_MODE=local
Environment=PORTAL_RESOURCE_SERVICE_PROCESS=1
Environment=PORTAL_RESOURCE_SERVICE_SOCKET=@PORTAL_INSTANCES_ROOT@/dev/resource-service.sock
Environment=PORTAL_RESOURCE_SERVICE_DB=@PORTAL_INSTANCES_ROOT@/dev/resource-service.partition
Environment=PORTAL_RESOURCE_DATABASE_SCHEMA=resource_dev
ExecStart=@PORTAL_GROUP_COMMAND@@PORTAL_INSTANCES_ROOT@/dev/runtime-venv/bin/python -m management_portal.resources.server
Restart=always
RestartSec=2
TimeoutStopSec=90

[Install]
WantedBy=portal-dev-execution.target
