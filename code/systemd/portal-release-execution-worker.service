[Unit]
Description=TFI Portal Release ExecutionWorker
After=network-online.target @PORTAL_POSTGRES_UNIT@ portal-release-nats.service portal-release-execution-service.service portal-claude-code.service portal-kimi-code.service
Wants=network-online.target @PORTAL_POSTGRES_UNIT@ portal-release-nats.service portal-release-execution-service.service portal-claude-code.service portal-kimi-code.service
StartLimitIntervalSec=5min
StartLimitBurst=5

[Service]
Environment=PYTHONDONTWRITEBYTECODE=1
Type=simple
UMask=0007
WorkingDirectory=@PORTAL_SOURCE_ROOT@
Environment=PORTAL_INSTANCE=release
Environment=PORTAL_ISA_ROUTING=socket
EnvironmentFile=-@PORTAL_POSTGRES_ENV_FILE@
Environment=PORTAL_EXECUTION_WORKER_GENERATION_ENV=@PORTAL_INSTANCES_ROOT@/dev/source-generation.env
Environment=PORTAL_EXECUTION_WORKER_COMPONENT_GENERATIONS=@PORTAL_INSTANCES_ROOT@/dev/component-generations.json
Environment=PORTAL_NATS_URL=nats://127.0.0.1:4224
Environment=PORTAL_EXECUTION_WORKER_ID=release:execution-worker
Environment=PORTAL_EXECUTION_SERVICE_SOCKET=@PORTAL_INSTANCES_ROOT@/release/execution-service.sock
Environment=PORTAL_EXECUTION_STATE_ROOT=@PORTAL_STAGING_ROOT@/portal_execution
Environment=PORTAL_EXECUTION_WORKER_HEALTH_PATH=@PORTAL_INSTANCES_ROOT@/release/execution-worker-health.json
Environment=PORTAL_EXECUTION_WORKER_SOURCE_ROOT=@PORTAL_SOURCE_ROOT@
EnvironmentFile=-@PORTAL_RENDERED_CONFIG_ROOT@/portal-kimi-code.env
ExecStart=@PORTAL_INSTANCES_ROOT@/dev/runtime-venv/bin/python @PORTAL_SOURCE_ROOT@/scripts/run_portal_shared_component.py execution-worker
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=10
LogRateLimitIntervalSec=1min
LogRateLimitBurst=100
TimeoutStopSec=90

[Install]
WantedBy=portal-release-execution.target
